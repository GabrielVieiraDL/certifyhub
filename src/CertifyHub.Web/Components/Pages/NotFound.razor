@page "/not-found"
@layout MainLayout

<PageTitle>Página não encontrada — CertifyHub</PageTitle>

<div class="card-box" style="text-align: center; padding: 4rem 2rem;">
    <span style="font-size: 3rem;">🔍</span>
    <h2 style="font-size: 1.5rem; font-weight: 800; color: #1e293b; margin: 1rem 0 0.5rem 0;">
        Página Não Encontrada (404)
    </h2>
    <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 1.5rem;">
        O recurso ou simulado que você está procurando não existe ou foi movido.
    </p>
    <a href="/" class="btn btn-primary">
        ← Voltar ao Início
    </a>
</div>
