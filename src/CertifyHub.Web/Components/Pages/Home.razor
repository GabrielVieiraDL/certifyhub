@page "/"
@using CertifyHub.Api.DTOs
@inject ExamApiService Api
@inject NavigationManager Nav

<PageTitle>CertifyHub — Catálogo de Exames de Certificação Microsoft</PageTitle>

<div class="card-box" style="text-align: center; margin-bottom: 2rem;">
    <div style="margin-bottom: 0.75rem;">
        <span class="brand-badge" style="font-size: 0.8rem; padding: 0.35rem 0.85rem;">
            MICROSOFT CERTIFICATION HUBS
        </span>
    </div>

    <h1 style="font-size: 2.1rem; font-weight: 800; color: #0078d4; margin-bottom: 0.6rem; letter-spacing: -0.02em;">
        Escolha o seu Exame de Certificação
    </h1>

    <p style="font-size: 1rem; color: #475569; max-width: 680px; margin: 0 auto 1.5rem auto; line-height: 1.5;">
        Simulados oficiais de alta fidelidade construídos com tecnologia .NET e alinhados às diretrizes do Microsoft Learn. Selecione a certificação desejada para treinar no <strong>Modo Exame Real</strong> ou no <strong>Modo Treinamento Interativo</strong>.
    </p>

    <!-- Grade de Seleção de Exames -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1.5rem; text-align: left; margin-top: 1.5rem;">
        
        <!-- CARD AZ-900: FUNDAMENTALS -->
        <div style="border: 2px solid #0078d4; border-radius: 12px; padding: 1.75rem; background: #ffffff; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 4px 6px -1px rgba(0, 120, 212, 0.08); transition: transform 0.2s ease, box-shadow 0.2s ease;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <span style="background: #e0f2fe; color: #0369a1; font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 4px; border: 1px solid #bae6fd;">
                        NÍVEL FUNDAMENTALS
                    </span>
                    <span style="background: #0078d4; color: white; font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 4px;">
                        AZ-900
                    </span>
                </div>

                <h2 style="font-size: 1.35rem; font-weight: 800; color: #1e293b; margin: 0 0 0.5rem 0;">
                    Microsoft Azure Fundamentals
                </h2>

                <p style="font-size: 0.9rem; color: #475569; line-height: 1.5; margin-bottom: 1.25rem;">
                    Valide seu conhecimento essencial sobre conceitos de nuvem, serviços de computação e armazenamento do Azure, segurança, conformidade e governança corporativa.
                </p>

                <!-- Destaques do Exame -->
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; font-size: 0.82rem; color: #334155;">
                        <div>⏱️ <strong>45 min</strong> de prova</div>
                        <div>🎯 <strong>700 / 1000</strong> corte</div>
                        <div>📚 <strong>3</strong> domínios oficiais</div>
                        <div>🎲 <strong>50</strong> questões/tentativa</div>
                    </div>
                </div>

                <div style="font-size: 0.85rem; color: #059669; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.4rem;">
                    <span>✅</span> <span>452 questões oficiais integradas</span>
                </div>
            </div>

            <button type="button"
                    class="btn btn-primary btn-block btn-lg"
                    @onclick='() => Nav.NavigateTo("/exam/AZ-900")'>
                Acessar Simulado AZ-900 →
            </button>
        </div>

        <!-- CARD AZ-104: ASSOCIATE -->
        <div style="border: 2px solid #d97706; border-radius: 12px; padding: 1.75rem; background: #ffffff; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 4px 6px -1px rgba(217, 119, 6, 0.08); transition: transform 0.2s ease, box-shadow 0.2s ease;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <span style="background: #fef3c7; color: #92400e; font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 4px; border: 1px solid #fde68a;">
                        NÍVEL ASSOCIATE
                    </span>
                    <span style="background: #d97706; color: white; font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 4px;">
                        AZ-104
                    </span>
                </div>

                <h2 style="font-size: 1.35rem; font-weight: 800; color: #1e293b; margin: 0 0 0.5rem 0;">
                    Microsoft Azure Administrator
                </h2>

                <p style="font-size: 0.9rem; color: #475569; line-height: 1.5; margin-bottom: 1.25rem;">
                    Demonstre suas habilidades práticas na implementação, gerenciamento e monitoramento de identidades, governança, armazenamento, recursos de computação e redes virtuais.
                </p>

                <!-- Destaques do Exame -->
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; font-size: 0.82rem; color: #334155;">
                        <div>⏱️ <strong>100 min</strong> de prova</div>
                        <div>🎯 <strong>700 / 1000</strong> corte</div>
                        <div>📚 <strong>5</strong> domínios oficiais</div>
                        <div>🛠️ Foco em administração</div>
                    </div>
                </div>

                <div style="font-size: 0.85rem; color: #059669; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.4rem;">
                    <span>✅</span> <span>440 questões oficiais integradas</span>
                </div>
            </div>

            <button type="button"
                    class="btn btn-amber btn-block btn-lg"
                    @onclick='() => Nav.NavigateTo("/exam/AZ-104")'>
                Acessar Simulado AZ-104 →
            </button>
        </div>
    </div>
</div>

<!-- Rodapé do Hub com Certificações Futuras -->
<div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 1.25rem 1.5rem; text-align: center; font-size: 0.85rem; color: #64748b;">
    <span style="font-weight: 700; color: #334155;">Próximas certificações em preparação:</span>
    <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 0.5rem; flex-wrap: wrap;">
        <span style="background: #ffffff; border: 1px solid #e2e8f0; padding: 0.25rem 0.6rem; border-radius: 4px;">AZ-204 (Azure Developer)</span>
        <span style="background: #ffffff; border: 1px solid #e2e8f0; padding: 0.25rem 0.6rem; border-radius: 4px;">AZ-500 (Azure Security Engineer)</span>
        <span style="background: #ffffff; border: 1px solid #e2e8f0; padding: 0.25rem 0.6rem; border-radius: 4px;">SC-900 (Security & Compliance)</span>
    </div>
</div>
